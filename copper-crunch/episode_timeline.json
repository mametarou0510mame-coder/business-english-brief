   "chapter": "WHY SO TIGHT?",
   "vis": {
    "type": "cards",
    "title": "Why mines can't keep up",
    "title_jp": "鉱山が追いつけない理由",
    "items": [
     {
      "title": "Poorer ore",
      "jp": "鉱石の品位が低下",
