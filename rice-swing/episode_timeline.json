     "start": 10.187,
     "end": 13.314,
     "audio": "00_02.wav"
    },
    {
     "en": "Today: how Japan swung from a rice shortage to a rice glut.",
     "jp": "今日は、日本が米不足から米余りに振れた流れを見ます。",
     "hl": [
      "shortage to a rice glut",
      "米不足から米余り"
     ],
     "start": 13.964,
     "end": 17.54,
     "audio": "00_03.wav"
    }
   ],
   "start": 0.0,
   "end": 18.54
  },
